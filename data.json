  "M": [
   "Short",
   "Mini blade: the small, short plastic blade fuse. On your lid these have the small outlines."
  ],
  "J": [
   "Tall",
   "Cartridge (J-Case): a taller, boxy fuse. On your lid these have the large outlines. A mini blade will not substitute."
  ],
  "L": [
   "Largest",
   "Fusible link: a big bolt-in style fuse for the main feed. Replace only with the exact same part."
  ],
  "P": [
   "Largest",
   "High-current 80A cartridge for the inverter circuit. Replace only with the exact same part."
  ],
  "S": [
   "Short pin",
   "Shunt pin: a small jumper, not a fuse. It stays in place unless a service procedure calls for removing it."
  ],
  "R": [
   "Relay",
   "Relay: a square plug-in switch, not a fuse. Swap only with the identical relay."
  ],
  "X": [
   "Accessory",
   "Stored on the lid, not part of the fuse circuits."
  ]
